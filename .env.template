NODE_ENV=development # (development, production)

# Domain configuration (optional — defaults shown below)
NEXT_PUBLIC_MAIN_DOMAIN=robinhoodarmy.com
NEXT_PUBLIC_CHECKIN_DOMAIN=checkin.robinhoodarmy.com
NEXT_PRIVATE_ADMIN_DOMAIN=admin.robinhoodarmy.com

# Database
DATABASE_URL=mysql://username:password@localhost:3306/rha_web_db

# JWT
JWT_SECRET=
JWT_EXPIRY_DAYS=7

# AWS SES
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-south-1
SES_FROM_EMAIL=

# File storage (check-in selfies, etc.)
# In development (NODE_ENV=development) files are written to the local filesystem
# under /public — the vars below are only needed for non-dev (S3) environments.
# STORAGE_DRIVER overrides the NODE_ENV default: set `s3` to test the real S3 /
# presigned upload flow locally (fill in the S3_* vars below), or `local` to force
# filesystem writes. Leave blank to follow NODE_ENV.
STORAGE_DRIVER= # optional — s3 | local
# Dedicated S3 credentials, separate from the SES creds above. Required in non-dev
# (S3) environments — S3 operations use ONLY these keys (no fallback).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-south-1 # optional — defaults to ap-south-1
S3_PUBLIC_BASE_URL= # optional — CDN/custom domain; else https://<bucket>.s3.<region>.amazonaws.com
# Prod bucket needs: public-read on `checkins/*`, and CORS allowing POST from your site origin.
